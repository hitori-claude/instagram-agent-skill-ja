  "structures": [
    {
      "id": "not-just",
      "regex": "(?:だけ|のみ)で(?:は)?なく[^。！？\\n]{1,40}(?:も|まで)",
      "name": "「AだけでなくBも」",
      "fix": "言いたい方だけ書く。前置きの半分は消してよさそう。"
    },
    {
      "id": "not-but",
      "regex": "ではなく[、，][^。！？\\n]{1,40}(?:なのです|なんです|です)。",
      "name": "「Aではなく、Bなのです」",
      "fix": "Bから書き始める。ひっくり返しの演出がAIっぽく見える。"
    },
    {
      "id": "welcome",
      "regex": "の世界へようこそ",
      "name": "「〜の世界へようこそ」",
      "fix": "あいさつを消して本題から入る。"
    },
    {
      "id": "teiki-mashou",
      "regex": "ていきましょう[！!]?",
      "name": "「〜していきましょう！」",
      "fix": "「〜してみて」「〜しよう」くらいの温度に。"
    },
    {
      "id": "three-points",
      "regex": "(?:ポイント|コツ|理由|方法|ステップ|特徴|メリット)は[3３三]つ|[3３三]つの(?:ポイント|コツ|理由|方法|ステップ|特徴|メリット)",
      "name": "「ポイントは3つ」",
      "fix": "3つはAIの定番リズム。2つか4つにするか、数を言わずに書く。"
    },
    {
      "id": "triad",
      "regex": "[^、。！？\\n]{1,12}、[^、。！？\\n]{1,12}、そして[^、。！？\\n]{1,15}",
      "name": "「A、B、そしてC」の三連",
      "fix": "「そして」を消すか、2つに減らす。"
    },
    {
      "id": "taigen-chain",
      "regex": "(?m)^(?:[^\\n。！？!?]*[一-龯ァ-ヴー]\\n){2,}[^\\n。！？!?]*[一-龯ァ-ヴー]$",
      "name": "体言止めの連続（3行以上）",
      "fix": "1行だけ「〜でした」「〜なんです」で終わらせて流れを作る。"
    },
    {
      "id": "question-open",
      "regex": "(?:お?悩み(?:は|、)?ありませんか|ご存[知じ](?:でしょうか|ですか)|と思ったことはありませんか)",
      "name": "問いかけで始まる定番の書き出し",
      "fix": "問いかけを消して、自分に起きたことから書く。"
    },
    {
      "id": "preamble",
      "regex": "(?:この|今回の)(?:記事|投稿|動画|リール)では|今回は[^。\\n]{1,30}(?:ご紹介|解説|お伝え)(?:します|していきます)",
      "name": "前置き（「今回は〜をご紹介します」）",
      "fix": "前置きを消して結論から。最初の2秒で決まる。"
    },
    {
      "id": "closer",
      "regex": "(?m)^\\s*(?:まとめ|結論|最後に)[：:]|最後まで(?:ご覧|読んで|見て)いただき",
      "name": "締めの決まり文句",
      "fix": "投稿にまとめの段落はいらない。最後の一文で止める。"
    },
    {
      "id": "deshou-repeat",
      "regex": "でしょう。[^\\n]*でしょう。",
      "name": "「〜でしょう。」の連発",
      "fix": "1つは言い切りに変える。"
    },
    {
      "id": "touten-heavy",
      "regex": "(?:[^。！？!?\\n、]{1,25}、){4,}",
      "name": "読点（、）が4つ以上ある長い一文",
      "fix": "2文に分ける。読点を減らす。"
    },
    {
      "id": "as-an-ai",
      "regex": "AIとして|言語モデルとして|AIアシスタントとして",
      "name": "AIの自己言及",
      "fix": "その文ごと消す。"
    },
    {
      "id": "emoji-bullets",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨▶■◆●☑]\\s*\\S",
      "name": "絵文字の箇条書き",
      "fix": "「・」か改行だけにする。絵文字の行頭はテンプレっぽさが一番出る。"
    },
    {
      "id": "sparkle-spam",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1✨\\U0001F3AF](?:\\s*[\\U0001F680\\U0001F525\\U0001F4A1✨\\U0001F3AF]){2,}",
      "name": "🚀🔥💡✨🎯 の連打",
      "fix": "絵文字は1つで足りる。"
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:[#＃][^\\s#＃]+[ \\t　]*){10,}",
      "name": "ハッシュタグの壁（10個以上）",
      "fix": "数を絞る。本文とつながるタグだけ残す。"
    },
    {
      "id": "follow-bait",
      "regex": "フォローしてね|フォローお願いします|いいね(?:と|&|＆|・)(?:保存|フォロー)|保存して(?:後で|あとで)?見返|コメントで教えて|シェアしてね",
      "name": "反射的なフォロー・保存のお願い",
      "fix": "お願いは1投稿に1つまで。この投稿ならではのお願いにする。"
    },
    {
      "id": "shout",
      "regex": "[！!]{3,}",
      "name": "「！！！」の3連以上",
      "fix": "1つで足りる。"
    }
  ]
}